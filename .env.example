# ============================================================================
# Simul Engine — Конфигурация облачного мира (Supabase)
# Скопируйте в .env.local и укажите данные вашего проекта Supabase.
# Если переменные не заданы, движок автоматически работает в LocalWorldAdapter
# с локальными сохранениями и симуляцией ИИ-конкурентов в общем пуле показов.
# ============================================================================

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
VITE_SIMUL_SEASON_ID=season-1
